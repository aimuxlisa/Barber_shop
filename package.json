{
  "name": "barbershop",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev -w @barbershop/web --",
    "dev:api": "npm run dev -w @barbershop/api --",
    "build": "npm run build -w @barbershop/web",
    "build:api": "npm run build -w @barbershop/api",
    "lint": "npm run lint -w @barbershop/web",
    "lint:api": "npm run lint -w @barbershop/api",
    "db:generate": "prisma generate --schema packages/db/prisma/schema.prisma",
    "db:migrate": "prisma migrate deploy --schema packages/db/prisma/schema.prisma",
    "db:migrate:dev": "prisma migrate dev --schema packages/db/prisma/schema.prisma",
    "db:seed": "npm run seed -w @barbershop/db",
    "db:studio": "prisma studio --schema packages/db/prisma/schema.prisma",
    "postinstall": "prisma generate --schema packages/db/prisma/schema.prisma",
    "dev:bot": "npm run dev -w @barbershop/bot --"
  },
  "devDependencies": {
    "prisma": "^6.16.3"
  }
}
