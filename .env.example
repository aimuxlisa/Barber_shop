# Supabase: Project Settings → Database.
# DATABASE_URL — transaction pooler (port 6543), used by the app.
# DIRECT_URL — session pooler or direct (port 5432), used by Prisma migrations.
DATABASE_URL="postgresql://postgres.PROJECT_REF:[YOUR-PASSWORD]@aws-0-REGION.pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.PROJECT_REF:[YOUR-PASSWORD]@aws-0-REGION.pooler.supabase.com:5432/postgres"

# Supabase: Project Settings → API. Server only. Never send the service role key to the browser.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# API (apps/api): port the Fastify server listens on.
PORT=3001
# API: allowed browser origins for CORS, comma-separated (development).
CORS_ORIGINS="http://localhost:3000"

# Web (apps/web): public base URL of the API used by the browser.
# Falls back to http://localhost:3001 when unset.
NEXT_PUBLIC_API_URL="http://localhost:3001"

# Telegram Bot (apps/bot)


